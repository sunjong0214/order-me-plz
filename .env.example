# 복사해서 쓴다:  cp .env.example .env   (.env 는 git 에 올라가지 않는다)
# Spring이 Java properties 형식으로 읽는다: KEY=VALUE, 따옴표 없이, 값 뒤 공백 없이.
# 빠진 키는 application.properties 의 기본값(아래 값과 같음)을 쓴다. 바꾼 뒤에는 재시작만 하면 된다(재빌드 불필요).
# 기동 인자(--OMP_HIKARI_MAX_POOL_SIZE=10)와 OS 환경변수가 이 파일보다 우선한다.

# --- DB ---
OMP_DB_URL=jdbc:mysql://localhost:3306/OMP
OMP_DB_USERNAME=root
OMP_DB_PASSWORD=1234

# --- 커넥션 총량 P (파일럿 P2 확정 20. P1 동기 5 / 10 / 15 / 20, P2 비동기 10 / 15 / 20) ---
OMP_HIKARI_MAX_POOL_SIZE=20

# --- 요청 스레드 (동기 경로) ---
OMP_TOMCAT_THREADS_MAX=200

# --- 리뷰 통계 모드: sync(채택) / async(③ 비교군) ---
OMP_REVIEW_STATS_MODE=sync
OMP_ORDER_ASYNC_STATE_TTL=5m

# --- 비동기 주문 트랜잭션 구성: single(채택, 워커 트랜잭션 하나에서 검증 + INSERT) / split(비교군, 접수 검증 + 워커 INSERT) ---
OMP_ORDER_ASYNC_TRANSACTION=single
# 대기 자리가 없을 때 응답 코드: 503(기본) / 429 (Tomcat은 503 뒤 연결을 닫음)
OMP_ORDER_ASYNC_REJECT_STATUS=503

# --- insert 워커 k, 큐 Q (파일럿 P2 확정: core = max = 20, Q = W × 30초 × 0.8 ≈ 70,000. 파일럿 중에는 queue 100) ---
OMP_EXECUTOR_INSERT_CORE=20
OMP_EXECUTOR_INSERT_MAX=20
OMP_EXECUTOR_INSERT_QUEUE=70000

# --- 리뷰 통계 워커 (③ 비교군, core = max = P/2 = 10) ---
OMP_EXECUTOR_REVIEW_STATS_CORE=10
OMP_EXECUTOR_REVIEW_STATS_MAX=10
OMP_EXECUTOR_REVIEW_STATS_QUEUE=2000

# --- SSE 전송 (DB 미사용, 커넥션 예산과 무관) ---
OMP_EXECUTOR_SSE_CORE=10
OMP_EXECUTOR_SSE_MAX=30
OMP_EXECUTOR_SSE_QUEUE=200
